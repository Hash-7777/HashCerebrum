{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "HashCerebrum default capability set. Scoped to the main window only. Custom IPC commands (medical fetchers, guard, audit) are registered via invoke_handler and need no entry here — only plugin-level JS APIs do. Keep this list minimal — every permission added is attack surface.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "notification:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "store:allow-delete",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
