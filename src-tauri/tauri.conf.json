{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "HashCerebrum",
  "version": "0.1.0",
  "identifier": "com.hashcerebrum.desktop",

  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },

  "app": {
    // Renderer must use the typed @tauri-apps/api package, not a window global.
    // withGlobalTauri=false reduces attack surface (no implicit window.__TAURI__).
    "withGlobalTauri": false,

    "windows": [
      {
        "label": "main",
        "title": "HashCerebrum",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "center": true,
        "visible": true
      }
    ],

    "security": {
      // ── Content Security Policy ────────────────────────────────
      // Strict by default. NO external script-src, NO inline scripts.
      // All external HTTP goes through Rust commands — the renderer
      // does not need connect-src to medical APIs.
      //
      // 'unsafe-inline' on style-src is needed for runtime theme tokens
      // and Three.js/R3F dynamic styles.
      //
      // LLM provider hosts are listed in connect-src so the renderer can
      // stream directly when the user opts into "frontend mode" for an
      // API provider. For "backend mode" (default), Rust proxies the call
      // and the connect-src entry is unused but kept for opt-in flexibility.
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com http://localhost:11434 http://127.0.0.1:11434; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Medical",
    "shortDescription": "Medical research agent desktop app",
    "longDescription": "HashCerebrum — A medical research agent desktop app for source-grounded outputs, evidence-hierarchy aware synthesis, and citation discipline. API keys stay in your OS keychain; all external requests route through an audited Rust backend.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null
    }
  }
}
