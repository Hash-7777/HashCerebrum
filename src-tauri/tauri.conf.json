{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "HashCerebrum",
  "version": "1.1.0",
  "identifier": "com.hashcerebrum.desktop",

  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },

  "app": {
    // Renderer must use the typed @tauri-apps/api package, not a window global.
    // withGlobalTauri=false reduces attack surface (no implicit window.__TAURI__).
    "withGlobalTauri": false,

    "windows": [
      {
        "label": "main",
        "title": "HashCerebrum",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "visible": false,
        "backgroundColor": "#070a0c"
      }
    ],

    "security": {
      // ── Content Security Policy ────────────────────────────────
      // Strict by default. NO external script-src, NO inline scripts,
      // and NO broad unsafe-eval. wasm-unsafe-eval is the narrow WebAssembly
      // allowance needed by WebKit/PDF rendering paths.
      // The same policy is set for production and dev builds so Tauri's
      // injected script hashes never drop the WebAssembly allowance.
      // All external HTTP — medical sources and LLM providers alike —
      // goes through Rust commands behind the audited guard, so the
      // renderer needs no external connect-src hosts at all.
      //
      // 'unsafe-inline' on style-src is needed for runtime theme tokens
      // and Three.js/R3F dynamic styles.
      //
      // connect-src is limited to 'self', blob:, and the Tauri IPC origin:
      // the renderer only talks to Rust, never to a provider host directly.
      // blob: is required so pdf.js can read the in-memory exported PDF it
      // rasterises for the in-app preview (the worker fetches the blob: URL);
      // a blob: URL is local in-memory data and cannot reach the network, so
      // the zero-egress guarantee is unchanged — no external host is allowed.
      //
      // frame-src allows 'self' and blob: so the in-app document preview
      // can render an exported PDF (a blob: URL) inside its <iframe>.
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' blob: ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' blob: ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Medical",
    "shortDescription": "Medical research agent desktop app",
    "longDescription": "HashCerebrum — A medical research agent desktop app for source-grounded outputs, evidence-hierarchy aware synthesis, and citation discipline. API keys stay in your OS keychain; all external requests route through an audited Rust backend.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null
    }
  }
}
