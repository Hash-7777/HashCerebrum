{
  "name": "hashcerebrum",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "HashCerebrum — a private, local-first agentic desktop app for medical research. A boss-and-specialist agent swarm fetches source-grounded evidence from trusted public biomedical databases (PubMed, Europe PMC, OpenAlex, ClinicalTrials.gov, openFDA, RxNorm, Semantic Scholar) and writes fully-cited answers and papers — with on-device semantic memory (a bundled medical embedding model + 3D vector map). Everything stays on your machine: no accounts, no cloud, no telemetry; run fully offline with local Ollama.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "npm run build:app",
    "build:web": "npm run typecheck && vite build",
    "build:app": "tauri build --bundles app",
    "build:app:debug": "tauri build --debug --bundles app",
    "build:all": "tauri build",
    "build:dmg": "tauri build --bundles dmg",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles app",
    "icons": "node scripts/generate-icons.mjs",
    "validate:brain-model": "node scripts/validate-brain-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@huggingface/transformers": "^4.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-store": "^2",
    "docx": "9.7.1",
    "dompurify": "^3.4.12",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {}
}
