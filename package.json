{
  "name": "hashcerebrum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HashCerebrum — Medical research agent desktop app",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "npm run build:app",
    "build:web": "npm run typecheck && vite build",
    "build:app": "tauri build --bundles app",
    "build:app:debug": "tauri build --debug --bundles app",
    "build:all": "tauri build",
    "build:dmg": "tauri build --bundles dmg",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles app",
    "icons": "node scripts/generate-icons.mjs",
    "validate:brain-model": "node scripts/validate-brain-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-store": "^2",
    "dompurify": "^3.4.5",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
