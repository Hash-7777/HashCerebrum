# =============================================================
# Node / Vite
# =============================================================
node_modules/
dist/
.vite/
*.tsbuildinfo

# =============================================================
# Rust / Tauri
# =============================================================
src-tauri/target/
src-tauri/gen/
# Cargo.lock is committed for reproducible builds (this is an application, not a library)
# src-tauri/Cargo.lock

# =============================================================
# OS / editor
# =============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================
# SECRETS — never commit ANY of these. Belt + suspenders.
# Real keys live in the OS keychain via tauri-plugin-keyring.
# =============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.jks
*.keystore
id_rsa
id_ed25519
id_ecdsa
*.gpg
*.asc
secrets/
credentials/
private/

# Coverage
coverage/
*.lcov

# =============================================================
# Runtime data — audit log + cache live in the OS app-data dir
# at runtime, not the repo. Keeping these patterns blocks any
# accidental redirect into the working tree.
# =============================================================
/audit/
/cache/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# =============================================================
# Build artifacts (output bundles)
# =============================================================
*.dmg
*.app
*.deb
*.AppImage
*.msi
*.exe

# =============================================================
# 3D model assets — kept in git so a clone is buildable without an
# external download. Pre-commit hook whitelists this path past the
# 5 MB guard. Always commit the LICENSE/README alongside the asset.
# =============================================================
# (no GLB/GLTF/BIN ignore here — they belong to the repo)

# =============================================================
# Log files
# =============================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
Sketches.jpg

# =============================================================
# Local-only files — NEVER committed. Operational notes, AI-coder
# instructions, session handoffs, progress reports and audit reports
# stay on the local machine only. Name any such file `*.local.md`
# and it is ignored automatically. See COMMIT_RULES.local.md.
# =============================================================
*.local.md
SESSION_HANDOFF.md
docs/SESSION_HANDOFF.md
REMAINING_WORK.md
*_REPORT.md
*_AUDIT.md
