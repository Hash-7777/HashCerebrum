# =============================================================
# Node / Vite
# =============================================================
node_modules/
dist/
.vite/
*.tsbuildinfo

# =============================================================
# Rust / Tauri
# =============================================================
src-tauri/target/
src-tauri/gen/
src-tauri/Cargo.lock

# =============================================================
# OS / editor
# =============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================
# SECRETS — never commit ANY of these. Belt + suspenders.
# Real keys live in the OS keychain via tauri-plugin-keyring.
# =============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.jks
*.keystore
id_rsa
id_ed25519
id_ecdsa
*.gpg
*.asc
secrets/
credentials/
private/

# Coverage
coverage/
*.lcov

# =============================================================
# Runtime data — audit log + cache live in the OS app-data dir
# at runtime, not the repo. Keeping these patterns blocks any
# accidental redirect into the working tree.
# =============================================================
audit/
cache/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# =============================================================
# Build artifacts (output bundles)
# =============================================================
*.dmg
*.app
*.deb
*.AppImage
*.msi
*.exe

# =============================================================
# Log files
# =============================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
