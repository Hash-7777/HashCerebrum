# onnxruntime-node is pulled in (as a hard dependency) by
# @huggingface/transformers, and its postinstall downloads a large native
# binary from the network. We only ever use onnxruntime-web (WASM, in a Web
# Worker) — the node binding is never loaded — so skip that download. Without
# this, `npm ci` fails on offline / network-restricted machines and CI
# (ETIMEDOUT). Read by onnxruntime-node/script/install-utils.js via
# `npm_config_onnxruntime_node_install`.
onnxruntime-node-install=skip
