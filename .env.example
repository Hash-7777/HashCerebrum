# =============================================================
# HashCerebrum — example env file
#
# ⚠ DO NOT PUT REAL API KEYS HERE. They belong in the OS keychain.
# This file documents the *non-secret* env vars the build accepts.
# Real .env files are gitignored, but the project does not read
# secrets from env anywhere — the keychain is the only source.
#
# Copy to .env (gitignored) if you need to set any of these.
# =============================================================

# Verbosity for the renderer-side logger (debug | info | warn | error)
VITE_LOG_LEVEL=info

# Rust log filter (see tracing-subscriber EnvFilter)
# RUST_LOG=info,hashcerebrum=debug

# Tauri host for mobile dev tunnel — leave unset for desktop
# TAURI_DEV_HOST=
